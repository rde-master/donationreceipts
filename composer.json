{
    "name": "rde-master/donationreceipts",
    "description": "Nextcloud app for German donation receipts (Zuwendungsbestätigungen)",
    "license": "AGPL-3.0-or-later",
    "autoload": {
        "psr-4": {
            "OCA\\DonationReceipts\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OCA\\DonationReceipts\\Tests\\": "tests/",
            "OCP\\": "vendor/nextcloud/ocp/OCP",
            "NCU\\": "vendor/nextcloud/ocp/NCU"
        },
        "files": [
            "3rdparty/autoload.php"
        ]
    },
    "require-dev": {
        "doctrine/dbal": "^3.9",
        "nextcloud/ocp": "dev-stable32",
        "phpunit/phpunit": "^10.5"
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
